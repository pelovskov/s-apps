---
---
[
  {% assign sider = site.pages | where_exp: "item", "item.name != 'index.md'" | where_exp: "item", "item.name != 'search.json'" %}
  {% for page in sider %}
  {
    "title": {{ page.title | default: page.name | jsonify }},
    "url": {{ site.baseurl | append: page.url | jsonify }},
    "content": {{ page.content | strip_html | strip_newlines | truncatewords: 100 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]